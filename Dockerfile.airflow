FROM apache/airflow:2.10.5-python3.11

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       openjdk-17-jre-headless curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

RUN mkdir -p /opt/spark-jars \
    && curl -fL --retry 3 \
       -o /opt/spark-jars/hadoop-aws-3.3.4.jar \
       https://repo.maven.apache.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar \
    && curl -fL --retry 3 \
       -o /opt/spark-jars/aws-java-sdk-bundle-1.12.262.jar \
       https://repo.maven.apache.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar \
    && chmod -R a+rX /opt/spark-jars

USER airflow

COPY requirements-airflow.txt /tmp/requirements-airflow.txt

RUN python -m venv /home/airflow/pipeline-venv \
    && PIP_USER=false /home/airflow/pipeline-venv/bin/python \
       -m pip install --no-cache-dir \
       -r /tmp/requirements-airflow.txt \
    && /home/airflow/pipeline-venv/bin/python -m pip check